{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Auto-publish portfolio to Cloudflare",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/auto-publish.ps1"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "portfolio-auto-publish",
          "pattern": {
            "regexp": "^AUTO-PUBLISH-ERROR: (.*)$",
            "message": 1
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^Auto-publish watcher started",
            "endsPattern": "^AUTO-PUBLISH-READY$"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
